<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" id="BorderPane" prefHeight="400.0" prefWidth="600.0" 
            styleClass="mainFxmlClass" fx:controller="com.bianca.fintrack.view.RelatorioController">
    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>
    <top>
        <VBox styleClass="cabecalhorelatorio" >
            <Label text="Relatório Financeiro" styleClass="titulorelatorio" />
            <HBox styleClass="areasaldo" >
                <Label text="Saldo atual:" styleClass="saldo"/>
                <Label fx:id="saldovalor" styleClass="valor"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox styleClass="corporelatorio" >
            <HBox>
                <Label text="Receitas:" styleClass="receitas"/>
                <Label fx:id="totalreceitas" styleClass="todasreceitas"/>
            </HBox>
            <HBox>
                <Label text="Despesas:" styleClass="despesas"/>
                <Label fx:id="totaldespesas" styleClass="todasdespesas"/>
            </HBox>
            <HBox>
                <Label text="Total de transações:" styleClass="transacoestotal"/>
                <Label fx:id="totaltransacoes" styleClass="todastransacoes"/>
            </HBox>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER" >
            <Button fx:id="butaoTelaPrincipal" text="Tela principal" onAction="#onirTelaPrincipal" styleClass="butaotela" />
            <Button fx:id="butaoAdicionar" text="Adicionar nova transação" onAction="#oncriarNovaTransacao" styleClass="primeirobutao" />
        </HBox>
    </bottom>
</BorderPane>
